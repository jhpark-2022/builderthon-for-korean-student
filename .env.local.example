# Supabase — 빌더톤 등록 저장소.
# Copy to .env.local (git-ignored) and fill in from:
#   Supabase dashboard → Project Settings → API

NEXT_PUBLIC_SUPABASE_URL=https://mojwmfjtuykmrjkntpve.supabase.co

# service_role key. SERVER-ONLY — it bypasses row-level security.
# Never prefix this with NEXT_PUBLIC_ and never reference it from a client
# component; it is read solely by lib/supabaseAdmin.ts.
SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare Turnstile. 12월 등록 폼(/api/crossing/register)의 봇 확인.
# Cloudflare dashboard → Turnstile → 사이트 추가에서 받습니다.
# 사이트 키는 공개 값이라 NEXT_PUBLIC_입니다. 비밀키는 서버 전용이라 NEXT_PUBLIC_를 붙이지 마세요.
# 비밀키가 없으면 개발에서는 확인을 건너뛰고, 운영에서는 503을 돌려줍니다.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# 운영에서 Turnstile 토큰의 호스트명을 확인합니다. 기본 허용 목록(운영 도메인) 밖의 호스트,
# 예를 들어 프리뷰 배포에서 폼을 시험하려면 쉼표로 이어 적습니다. 비워 두면 기본 목록만 씁니다.
TURNSTILE_ALLOWED_HOSTNAMES=

# /match 현장 방 코드(선택). 값을 넣으면 /api/crossing/match가 같은 코드를 요구합니다.
# QR은 /match?code=<값>으로 만듭니다. 비워 두면 코드 없이 받습니다.
# NEXT_PUBLIC_MATCH_ROOM_CODE_ON=1이면 시작 화면에 코드 입력 칸도 보입니다.
MATCH_ROOM_CODE=
NEXT_PUBLIC_MATCH_ROOM_CODE_ON=
